# PLZL_CONFIG_FILE optionally selects a non-secret TOML file.
PLZL_ENVIRONMENT=development
PLZL_DEPLOYMENT_MODE=container
PLZL_DATABASE_URL=postgresql://links_app@localhost:5432/links
PLZL_WORKER_DATABASE_URL=postgresql://links_worker@localhost:5432/links
PLZL_REDIS_URL=redis://localhost:6379/0
PLZL_OPENFGA_URL=http://localhost:8080
PLZL_OPENFGA_STORE_ID=
PLZL_OPENFGA_MODEL_ID=
PLZL_IDENTITY_ISSUER=https://identity.example.com
PLZL_IDENTITY_AUDIENCE=https://links.example.com/api/v1
PLZL_IDENTITY_CLIENT_ID=
# Supply secrets through these selectors or *_FILE. Do not put them in TOML.
PLZL_IDENTITY_CLIENT_SECRET=
PLZL_IDENTITY_PUBLIC_BASE_URL=https://links.example.com
PLZL_IDENTITY_ALLOW_INSECURE_LOOPBACK=false
PLZL_IDENTITY_SESSION_TTL=900
PLZL_RATE_LIMIT_ENABLED=true
# Exact immediate proxy IPs only. The proxy must sanitize/append X-Forwarded-For.
PLZL_TRUSTED_PROXY_IPS=[]
PLZL_SMTP_HOST=localhost
PLZL_SMTP_PORT=587
PLZL_SMTP_SECURITY=starttls
PLZL_SMTP_USER=
PLZL_SMTP_PASSWORD=
PLZL_SMTP_FROM=no-reply@example.com
PLZL_SMTP_FROM_NAME=Plazia Links
PLZL_SMTP_TIMEOUT=10
PLZL_WORKER_INTERVAL=5
# Enable OTLP export through shared observability; keep the endpoint free of credentials.
PLZL_TELEMETRY_EXPORT_DRIVER=noop
PLZL_TELEMETRY_OTLP_ENDPOINT=
PLZL_TELEMETRY_OTLP_TIMEOUT_SECONDS=5
PLZL_TELEMETRY_METRIC_EXPORT_INTERVAL_MILLIS=10000
