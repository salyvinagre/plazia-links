# Copy to .env at the repository root. Never commit .env.
# Generate distinct secrets with: uv run python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_USER=plazia_links
POSTGRES_DB=plazia_links
POSTGRES_PASSWORD=replace-with-a-random-password
SECRET_KEY=replace-with-a-separate-random-secret
JWT_SECRET=replace-with-another-random-secret

# Host development: PostgreSQL/Redis ports are bound only to 127.0.0.1.
# For the full Compose stack, change hosts to postgres and redis respectively.
# Use the same password as POSTGRES_PASSWORD; URL-encode any special characters.
DATABASE_URL=postgresql+asyncpg://plazia_links:replace-with-a-random-password@127.0.0.1:5432/plazia_links
REDIS_URL=redis://127.0.0.1:6379/0
ENVIRONMENT=development
DEFAULT_DOMAIN=localhost:8000
CORS_ORIGINS=http://localhost:8000
# False only for loopback HTTP development. Enable for HTTPS deployments.
SECURE_COOKIES=false

# SMTP transport is not configured by default.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Plazia Links
SMTP_USER=
SMTP_PASSWORD=

# Identity is the default deployed profile. No local password or API-key fallback.
AUTH_MODE=identity
# Copy the exact issuer from your product's Identity configuration.
IDENTITY_ISSUER=https://identity.example.com
IDENTITY_AUDIENCE=https://links.example.com/api
IDENTITY_CLIENT_ID=configure-a-confidential-browser-client
IDENTITY_CLIENT_SECRET=configure-its-private-client-secret
IDENTITY_SESSION_TTL=900
IDENTITY_PUBLIC_BASE_URL=http://localhost:8000
IDENTITY_ALLOW_INSECURE_LOOPBACK=true
