# salyvinagre/plazia-links — local Domain environment
# ==== REQUIRED ====
# app: database url.
# PLZK_DATABASE_URL=
# Owner-only Flyway connection document for the schema migration job.
# PLZK_FLYWAY_USER_TOML=
# Existing Plazia business owner used by Identity's enrollment session.
PLZK_IDENTITY_OWNER_EMAIL=
# app: redis url.
# PLZK_REDIS_URL=
# owner: database url.
# PLZK_SCHEMA_DATABASE_URL=
# worker: database url.
# PLZK_WORKER_DATABASE_URL=
# worker: smtp from.
PLZK_WORKER_SMTP_FROM=
# worker: smtp host.
PLZK_WORKER_SMTP_HOST=
# ==== OVERRIDABLE ====
# Deployment-owned TOML projection for API, worker and Identity settings.
# PLZK_CONFIG_FILE=
# app: environment.
# PLZK_ENVIRONMENT=development
# identity: allow insecure loopback.
# PLZK_IDENTITY_ALLOW_INSECURE_LOOPBACK=false
# identity: public base url.
# PLZK_IDENTITY_PUBLIC_BASE_URL=http://localhost:8000
# identity: session ttl.
# PLZK_IDENTITY_SESSION_TTL=900
# Links runtime image selected for Compose deployment.
# PLZK_IMAGE=plazia-links:local
# app: rate limit enabled.
# PLZK_RATE_LIMIT_ENABLED=true
# app: telemetry export driver.
# PLZK_TELEMETRY_EXPORT_DRIVER=noop
# app: telemetry metric export interval millis.
# PLZK_TELEMETRY_METRIC_EXPORT_INTERVAL_MILLIS=10000
# app: telemetry otlp endpoint.
# PLZK_TELEMETRY_OTLP_ENDPOINT=
# app: telemetry otlp timeout seconds.
# PLZK_TELEMETRY_OTLP_TIMEOUT_SECONDS=5
# app: trusted proxy ips.
# PLZK_TRUSTED_PROXY_IPS=[]
# worker: environment.
# PLZK_WORKER_ENVIRONMENT=development
# worker: interval.
# PLZK_WORKER_INTERVAL=5
# worker: smtp from name.
# PLZK_WORKER_SMTP_FROM_NAME=Plazia Links
# worker: smtp password.
# PLZK_WORKER_SMTP_PASSWORD=
# worker: smtp port.
# PLZK_WORKER_SMTP_PORT=587
# worker: smtp security.
# PLZK_WORKER_SMTP_SECURITY=starttls
# worker: smtp timeout.
# PLZK_WORKER_SMTP_TIMEOUT=10
# worker: smtp user.
# PLZK_WORKER_SMTP_USER=
# worker: telemetry export driver.
# PLZK_WORKER_TELEMETRY_EXPORT_DRIVER=noop
# worker: telemetry metric export interval millis.
# PLZK_WORKER_TELEMETRY_METRIC_EXPORT_INTERVAL_MILLIS=10000
# worker: telemetry otlp endpoint.
# PLZK_WORKER_TELEMETRY_OTLP_ENDPOINT=
# worker: telemetry otlp timeout seconds.
# PLZK_WORKER_TELEMETRY_OTLP_TIMEOUT_SECONDS=5
# Imported from plazia-tooling — exported DevOps environment
# ==== OVERRIDABLE ====
# Shared flyway image reference selected by the release pipeline.
# Catalog: flyway; optional full-reference override (plans: preview, production)
# PLZ_FLYWAY_IMAGE=
# Podman machine for shared stack tooling; empty uses engine discovery.
# PLZ_STACK_PODMAN_MACHINE=
