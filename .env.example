# salyvinagre/plazia-links — local Domain environment
# ==== REQUIRED ====
# Owner Flyway password for the explicit migration job.
# FLYWAY_PASSWORD=
# Owner Flyway url for the explicit migration job.
# FLYWAY_URL=
# Owner Flyway user for the explicit migration job.
# FLYWAY_USER=
# Host file containing the API-role PostgreSQL DSN.
PLZL_APP_DATABASE_URL_PATH=
# Host path of the non-secret Compose TOML configuration.
PLZL_CONFIG_PATH=
# identity: audience.
PLZL_IDENTITY_AUDIENCE=
# identity: client id.
PLZL_IDENTITY_CLIENT_ID=
# identity: client secret.
# PLZL_IDENTITY_CLIENT_SECRET=
# Host file containing the OAuth client secret.
PLZL_IDENTITY_CLIENT_SECRET_PATH=
# identity: issuer.
PLZL_IDENTITY_ISSUER=
# app: openfga model id.
PLZL_OPENFGA_MODEL_ID=
# app: openfga store id.
PLZL_OPENFGA_STORE_ID=
# app: openfga url.
PLZL_OPENFGA_URL=
# Host file containing the Redis credential URL.
PLZL_REDIS_URL_PATH=
# Host file containing the SMTP password.
PLZL_SMTP_PASSWORD_PATH=
# app: worker database url.
# PLZL_WORKER_DATABASE_URL=
# Host file containing the worker-role PostgreSQL DSN.
PLZL_WORKER_DATABASE_URL_PATH=
# ==== OVERRIDABLE ====
# Optional non-secret TOML settings file for app and identity.
# PLZL_CONFIG_FILE=
# app: database url.
# PLZL_DATABASE_URL=
# app: deployment mode.
# PLZL_DEPLOYMENT_MODE=container
# app: environment.
# PLZL_ENVIRONMENT=development
# identity: allow insecure loopback.
# PLZL_IDENTITY_ALLOW_INSECURE_LOOPBACK=false
# identity: public base url.
# PLZL_IDENTITY_PUBLIC_BASE_URL=http://localhost:8000
# identity: session ttl.
# PLZL_IDENTITY_SESSION_TTL=900
# Immutable runtime image selected for Compose deployment.
# PLZL_IMAGE=plazia-links:local
# app: rate limit enabled.
# PLZL_RATE_LIMIT_ENABLED=true
# app: redis url.
# PLZL_REDIS_URL=
# app: smtp from.
# PLZL_SMTP_FROM=no-reply@example.com
# app: smtp from name.
# PLZL_SMTP_FROM_NAME=Plazia Links
# app: smtp host.
# PLZL_SMTP_HOST=localhost
# app: smtp password.
# PLZL_SMTP_PASSWORD=
# app: smtp port.
# PLZL_SMTP_PORT=587
# app: smtp security.
# PLZL_SMTP_SECURITY=starttls
# app: smtp timeout.
# PLZL_SMTP_TIMEOUT=10
# app: smtp user.
# PLZL_SMTP_USER=
# app: telemetry export driver.
# PLZL_TELEMETRY_EXPORT_DRIVER=noop
# app: telemetry metric export interval millis.
# PLZL_TELEMETRY_METRIC_EXPORT_INTERVAL_MILLIS=10000
# app: telemetry otlp endpoint.
# PLZL_TELEMETRY_OTLP_ENDPOINT=
# app: telemetry otlp timeout seconds.
# PLZL_TELEMETRY_OTLP_TIMEOUT_SECONDS=5
# app: trusted proxy ips.
# PLZL_TRUSTED_PROXY_IPS=[]
# app: worker interval.
# PLZL_WORKER_INTERVAL=5
