{
  "version": 1,
  "business": {"name": "Plazia"},
  "environments": [{"ref": "selected"}],
  "applications": [
    {
      "ref": "links",
      "name": "plazia-links",
      "type": "reg",
      "environment": "selected",
      "token_endpoint_auth_method": "client_secret_basic",
      "redirect_paths": ["/auth/callback"],
      "logout_paths": ["/signed-out"],
      "initiate_login_path": "/login"
    }
  ],
  "apis": [
    {
      "ref": "links",
      "name": "plazia-links",
      "audience_path": "/api/v1",
      "visibility": "published",
      "scopes": [
        {"ref": "read", "key": "links:read", "description": "Read organization links."},
        {"ref": "create", "key": "links:create", "description": "Create organization links."},
        {"ref": "update", "key": "links:update", "description": "Activate and edit organization links."},
        {"ref": "delete", "key": "links:delete", "description": "Delete organization links."},
        {"ref": "pools-read", "key": "pools:read", "description": "Read organization pools."},
        {"ref": "pools-create", "key": "pools:create", "description": "Reserve organization pools."},
        {"ref": "pools-update", "key": "pools:update", "description": "Rename organization pools."},
        {"ref": "pools-delete", "key": "pools:delete", "description": "Delete organization pools."},
        {"ref": "pixels-read", "key": "pixels:read", "description": "Read organization pixels."},
        {"ref": "pixels-create", "key": "pixels:create", "description": "Create organization pixels."},
        {"ref": "pixels-delete", "key": "pixels:delete", "description": "Delete organization pixels."},
        {"ref": "statistics-read", "key": "statistics:read", "description": "Read organization link statistics."}
      ]
    }
  ],
  "grants": [
    {
      "application": "links",
      "api": {"ref": "links"},
      "scopes": [
        {"ref": "read"}, {"ref": "create"}, {"ref": "update"}, {"ref": "delete"},
        {"ref": "pools-read"}, {"ref": "pools-create"}, {"ref": "pools-update"}, {"ref": "pools-delete"},
        {"ref": "pixels-read"}, {"ref": "pixels-create"}, {"ref": "pixels-delete"}, {"ref": "statistics-read"}
      ]
    }
  ],
  "outputs": [
    {"key": "PLZK_IDENTITY_AUDIENCE", "source": "api.audience", "ref": "links"},
    {"key": "PLZK_IDENTITY_API_ID", "source": "api.id", "ref": "links"},
    {"key": "PLZK_IDENTITY_LINK_READ_SCOPE_ID", "source": "api_scope.id", "ref": "links", "scope": "read"},
    {"key": "PLZK_IDENTITY_LINK_UPDATE_SCOPE_ID", "source": "api_scope.id", "ref": "links", "scope": "update"},
    {"key": "PLZK_IDENTITY_LINK_DELETE_SCOPE_ID", "source": "api_scope.id", "ref": "links", "scope": "delete"},
    {"key": "PLZK_IDENTITY_POOL_CREATE_SCOPE_ID", "source": "api_scope.id", "ref": "links", "scope": "pools-create"},
    {"key": "PLZK_IDENTITY_ISSUER", "source": "environment.preferred_issuer", "ref": "selected"},
    {"key": "PLZK_IDENTITY_CLIENT_ID", "source": "application.client_id", "ref": "links"},
    {"key": "PLZK_IDENTITY_CLIENT_SECRET", "source": "application.client_secret", "ref": "links", "missing": "rotate_once"}
  ]
}
