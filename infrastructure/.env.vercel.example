# Import these into the Vercel project, scoped to its test environment.
# These are placeholders, never deployable secrets. Do not commit populated .env files.
ENVIRONMENT=production
AUTH_MODE=identity
DEPLOYMENT_MODE=serverless
# Use a reachable, direct PostgreSQL 18 endpoint. Percent-encode URL credentials.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@postgres.example.invalid:5432/links_preview?ssl=verify-full
# A Redis TCP/TLS URL, NOT an HTTPS REST API token. Redis 6.2+ GETDEL/SET NX are required.
REDIS_URL=rediss://default:PASSWORD@redis.example.invalid:6379/0
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
IDENTITY_ISSUER=https://identity.example.invalid
IDENTITY_AUDIENCE=https://links-api.example.invalid
IDENTITY_CLIENT_ID=REPLACE_WITH_CONFIDENTIAL_BROWSER_CLIENT
IDENTITY_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# A stable HTTPS test URL whose exact /auth/callback is registered at Identity.
IDENTITY_PUBLIC_BASE_URL=https://links-preview.example.invalid
IDENTITY_ALLOW_INSECURE_LOOPBACK=false
IDENTITY_SESSION_TTL=900
CORS_ORIGINS=https://links-preview.example.invalid
SECURE_COOKIES=true
